# =====================================================================
#  Copiar a .env (cp .env.example .env) y cambiar TODOS los valores "cambia-esto".
#  .env está en .gitignore: nunca subir credenciales al repositorio.
# =====================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=agente
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=agente

# ---------- Panel /admin ----------
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-por-un-secreto-largo

# ---------- Hugging Face ----------
# Token de lectura (https://huggingface.co/settings/tokens). Necesario si el modelo es "gated".
HF_TOKEN=
EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
EMBED_FALLBACK_MODEL=BAAI/bge-m3
EMBED_QUERY_PREFIX="query: "
EMBED_DOC_PREFIX="passage: "
# cpu (por defecto, no compite por VRAM) o cuda (requiere build con TORCH_INDEX=cu124)
EMBED_DEVICE=cpu
RERANK_ENABLED=true
RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
RERANK_FALLBACK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- Ollama (agente principal) ----------
OLLAMA_MODEL=nemotron-3-nano
OLLAMA_CONTEXT_LENGTH=16384

# ---------- vLLM (visión + juez) ----------
VLLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_MAX_MODEL_LEN=16384
# Fracción de VRAM para vLLM (el resto queda para Ollama)
VLLM_GPU_UTIL=0.45
VLLM_API_KEY=cambia-esto
VLLM_TAG=v0.11.0

# Qué servidor ejecuta el agente: ollama (recomendado) | vllm
AGENT_BACKEND=ollama
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180

# ---------- Recuperación ----------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20
HYBRID_WEIGHT_LEXICAL=0.3
HYBRID_WEIGHT_VECTOR=0.7
CHUNK_MAX_TOKENS=512
CHUNK_TOKENIZER=BAAI/bge-m3
# Describir figuras con Qwen2.5-VL durante la ingesta (requiere vLLM arriba)
INGEST_DESCRIBE_FIGURES=false

# ---------- Caché ----------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# ---------- ngrok ----------
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

FRONTEND_PORT=8080
